<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="NoteApp.Windows.RegisterWindow"
        Title="NOTE" 
        Width="1000" 
        Height="750" 
        MinWidth="360" 
        MinHeight="500" 
        RequestedThemeVariant="Light"
        WindowStartupLocation="CenterScreen" 
        Background="#FFFBEF">
    
        <Grid RowDefinitions="Auto,*">
            
            <StackPanel Grid.Row="0" 
                        Orientation="Horizontal" 
                        Spacing="16" 
                        VerticalAlignment="Center" 
                        Margin="32,24,32,16">
                        
                        <Border Background="#FFC928" 
                                CornerRadius="14" 
                                Width="54" 
                                Height="54">
                                
                                <TextBlock Text="▤" 
                                           FontSize="32" 
                                           Foreground="#202238" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                        </Border>
                        
                        <TextBlock Text="NOTE" 
                                   FontSize="30" 
                                   FontWeight="Bold" 
                                   Foreground="#202238" 
                                   VerticalAlignment="Center"/>
                </StackPanel>
                
                <Grid Grid.Row="1" 
                        Margin="20,12,20,28">
                        
                        <Border MaxWidth="560"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#FFFFFF"
                                CornerRadius="24"
                                Padding="40">
                                
                                <StackPanel Spacing="0">
                                        <TextBlock  Text="Добро пожаловать!" 
                                                    FontSize="34" 
                                                    FontWeight="Bold" 
                                                    Foreground="#202238" 
                                                    HorizontalAlignment="Center"
                                                    TextWrapping="Wrap"/>
                                        <TextBlock Text="Создайте свой аккаунт" 
                                                   FontSize="16" 
                                                   Foreground="#8586A5" 
                                                   TextAlignment="Center" 
                                                   HorizontalAlignment="Center" 
                                                   TextWrapping="Wrap" 
                                                   Margin="0,12,0,30"/>
                                        
                                        <TextBlock Text="Email:" 
                                                   FontSize="20" 
                                                   FontWeight="SemiBold"
                                                   Foreground="#202238"
                                                   Margin="0,0,0,8"/>
                                        
                                        <TextBox x:Name="EmailTextBox" 
                                                 PlaceholderText="Введите email" 
                                                 Padding="14,12" 
                                                 FontSize="18" 
                                                 MinHeight="52"
                                                 Background="#FFFFFF"
                                                 Foreground="#202238"
                                                 BorderBrush="#DFDFEA" 
                                                 BorderThickness="1.5" 
                                                 CornerRadius="12"/>

                                        <TextBlock Text="Логин:" 
                                                   FontSize="20" 
                                                   FontWeight="SemiBold"
                                                   Foreground="#202238"
                                                   Margin="0,22,0,8"/>
                                        
                                        <TextBox x:Name="LoginTextBox" 
                                                 PlaceholderText="Введите логин" 
                                                 Padding="14,12" 
                                                 FontSize="18" 
                                                 MinHeight="52"
                                                 Background="#FFFFFF"
                                                 Foreground="#202238"
                                                 BorderBrush="#DFDFEA" 
                                                 BorderThickness="1.5" 
                                                 CornerRadius="12"/>
                                        
                                        <TextBlock Text="Пароль:" 
                                                   FontSize="20" 
                                                   FontWeight="SemiBold"
                                                   Foreground="#202238" 
                                                   Margin="0,22,0,8" />
                                        
                                        <TextBox x:Name="PasswordTextBox" 
                                                 PlaceholderText="Введите пароль" 
                                                 Padding="14,12" 
                                                 FontSize="18" 
                                                 MinHeight="52"
                                                 Background="#FFFFFF"
                                                 Foreground="#202238"
                                                 BorderBrush="#DFDFEA" 
                                                 BorderThickness="1.5" 
                                                 CornerRadius="12"/>
                                        
                                        <Button x:Name="RegisterButton"
                                                Content="Зарегистрироваться" 
                                                Height="52" 
                                                Margin="0,28,0,0" 
                                                Background="#FFC928" 
                                                Foreground="#202238" 
                                                FontSize="20" 
                                                HorizontalContentAlignment="Center" 
                                                VerticalContentAlignment="Center"
                                                CornerRadius="12" 
                                                BorderThickness="0"
                                                HorizontalAlignment="Stretch"/>
                                        
                                        <StackPanel Orientation="Horizontal" 
                                                    HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center" 
                                                    Spacing="5" Margin="0,24,0,0">
                                            
                                            <TextBlock Text="Есть аккаунт?" 
                                                       FontSize="15" Foreground="#8586A5" 
                                                       VerticalAlignment="Center"/> 
                                            
                                            <Button x:Name="LoginButton"
                                                    Content="Войти" 
                                                    Background="Transparent" 
                                                    Foreground="#D99A00" 
                                                    FontSize="15" 
                                                    Padding="0" 
                                                    BorderThickness="0" 
                                                    VerticalAlignment="Center"/>
                                        </StackPanel>
                                </StackPanel>
                        </Border>
               </Grid>
            <Border x:Name="MessageOverlay"
                IsVisible="False"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="#33202238"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="340"
                    Margin="24"
                    Background="#FFFFFF"
                    BorderBrush="#F0E9D8"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="24">

                <StackPanel Spacing="16">

                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">

                        <Border Width="34"
                                Height="34"
                                CornerRadius="10"
                                Background="#FFF3C4">
                            <TextBlock Text="!"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#B98200"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Уведомление"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#202238"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="MessageText"
                               TextWrapping="Wrap"
                               FontSize="15"
                               Foreground="#8586A5"/>

                    <Button Content="Понятно"
                            HorizontalAlignment="Stretch"
                            Height="44"
                            Background="#FFC928"
                            Foreground="#202238"
                            FontSize="16"
                            FontWeight="SemiBold"
                            CornerRadius="12"
                            BorderThickness="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="OnMessageCloseClick"/>
                </StackPanel>
            </Border>
        </Border>
        </Grid>
</Window>
